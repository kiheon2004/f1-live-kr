{
  "name": "f1-live-kr",
  "version": "0.58.0",
  "description": "한국어 라이브 타이밍 데스크톱 앱 (비공식, 개인용)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "verify:demo": "node tools/verify-demo.js",
    "test": "node --test test/*.test.js test/game/*.test.js",
    "dist": "electron-builder --mac dir",
    "share": "electron-builder --mac zip --arm64 --x64 && electron-builder --win zip --x64",
    "vendor": "cp node_modules/three/build/three.module.js node_modules/three/build/three.core.js src/renderer/vendor/ && sed \"s#from 'three';#from './three.module.js';#\" node_modules/three/examples/jsm/controls/OrbitControls.js > src/renderer/vendor/OrbitControls.js && for f in utils/BufferGeometryUtils utils/SkeletonUtils loaders/GLTFLoader; do sed -e \"s#from 'three';#from './three.module.js';#\" -e \"s#from '../utils/#from './#\" node_modules/three/examples/jsm/$f.js > src/renderer/vendor/$(basename $f).js; done",
    "postinstall": "npm run vendor"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "kr.local.livetiming",
    "productName": "LiveTimingKR",
    "directories": {
      "output": "dist.noindex",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!src/main/dev-snapshot.js",
      "!src/main/dev-livefile.js"
    ],
    "mac": {
      "category": "public.app-category.sports",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "라이브 타이밍 KR",
        "LSHasLocalizedDisplayName": true
      }
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "author": "namkiheon"
}
